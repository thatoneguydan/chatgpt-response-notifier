{
  "manifest_version": 3,
  "name": "ChatGPT Quick Continue",
  "version": "1.1.0",
  "description": "Adds timestamped one-click Continue and JSON-backed Project Continue controls to ChatGPT.",
  "minimum_chrome_version": "116",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "prompt-format.js",
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "projects.json"
      ],
      "matches": [
        "https://chatgpt.com/*"
      ]
    }
  ]
}
