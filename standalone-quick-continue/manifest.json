{
  "manifest_version": 3,
  "name": "ChatGPT Quick Continue",
  "version": "1.2.7",
  "description": "Adds timestamped one-click Continue, optional timestamps for manual messages, live-editable JSON templates, and delayed hover editing to ChatGPT.",
  "minimum_chrome_version": "116",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "prompt-format.js",
        "config.js",
        "content-script.js",
        "hover-edit-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "config.json"
      ],
      "matches": [
        "https://chatgpt.com/*"
      ]
    }
  ],
  "permissions": [
    "storage"
  ]
}
