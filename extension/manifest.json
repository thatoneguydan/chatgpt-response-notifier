{
  "manifest_version": 3,
  "name": "ChatGPT Response Notifier",
  "version": "0.4.0",
  "description": "Reliable upstream ChatGPT completion detection with persistent stacked Windows notifications.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "scripting",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "ws://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ChatGPT Response Notifier",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content-script.js",
        "persistence-script.js",
        "recovery-script.js"
      ],
      "run_at": "document_start"
    }
  ]
}
